# Copy to .env.local (never commit it).

# Where the Next.js server forwards /api/* requests: the oms-be API.
OMS_API_URL=http://127.0.0.1:8000

# Where customers see the store, for the live preview in Setup > Diseño.
# {slug} is replaced with the store slug.
# NEXT_PUBLIC_STOREFRONT_URL=http://{slug}.localhost:3001

# Used by `pnpm api:fetch` to refresh openapi/openapi.json from a running API
# started with OMS_SHOW_API_DOCS=true.
# OMS_OPENAPI_URL=http://127.0.0.1:8000/openapi.json
