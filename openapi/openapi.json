            "area": "team",
            "level": "full"
          }
        ]
      },
      "delete": {
        "tags": [
          "team"
        ],
        "summary": "Remove Member",
        "operationId": "remove_member_team_members__member_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "member_id",
            "in": "path",
            "required": true,
            "schema": {
