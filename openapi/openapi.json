    "/team/members/{member_id}": {
      "patch": {
        "tags": [
          "team"
        ],
        "summary": "Update Member",
        "operationId": "update_member_team_members__member_id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "member_id",
            "in": "path",
