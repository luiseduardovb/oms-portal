      },
      "patch": {
        "tags": [
          "merchant"
        ],
        "summary": "Update Legal",
        "operationId": "update_legal_merchant_legal_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LegalUpdate"
