          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "x-required-permission": [
          {
            "area": "team",
            "level": "view"
          }
        ]
      }
    },
    "/team/roles": {
      "get": {
        "tags": [
          "team"
        ],
        "summary": "Roles",
        "operationId": "roles_team_roles_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RoleOut"
                  },
                  "type": "array",
                  "title": "Response Roles Team Roles Get"
