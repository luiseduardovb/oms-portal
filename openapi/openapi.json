            "title": "Email"
          },
          "roleId": {
            "type": "integer",
            "title": "Roleid"
          },
          "roleName": {
            "type": "string",
            "title": "Rolename"
          },
          "allOutlets": {
            "type": "boolean",
            "title": "Alloutlets"
          },
          "expiresAt": {
            "type": "string",
