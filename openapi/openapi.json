          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "roleId",
          "roleName",
          "allOutlets",
          "expiresAt",
          "createdAt",
          "token"
        ],
        "title": "InvitationCreated"
      },
      "InvitationOut": {
