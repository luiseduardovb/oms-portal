                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "x-required-permission": [
          {
            "owner": "true"
          }
        ]
      }
    },
    "/team/members": {
      "get": {
        "tags": [
          "team"
        ],
        "summary": "Members",
        "operationId": "members_team_members_get",
